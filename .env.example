# Environment Variables Template
# Copy this file to .env.local for local development

# -----------------------------------------------------------------------------
# Site Configuration
# -----------------------------------------------------------------------------
# Base URL for the website (used for SEO canonical tags, OpenGraph images, sitemap, and robots.txt)
NEXT_PUBLIC_SITE_URL=https://mistry-harsh.vercel.app

# -----------------------------------------------------------------------------
# Contact Form (Web3Forms API Integration)
# -----------------------------------------------------------------------------
# Access Key for Web3Forms to receive contact form submissions directly to email
# Get your free key at: https://web3forms.com
NEXT_PUBLIC_WEB3FORMS_KEY=your_web3forms_access_key_here

# -----------------------------------------------------------------------------
# Search Engine Verification
# -----------------------------------------------------------------------------
# Google Search Console Verification Code
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_site_verification_code_here

# -----------------------------------------------------------------------------
# Blog API Integrations (Optional)
# -----------------------------------------------------------------------------
# Dev.to API Key (Optional: for fetching draft/private posts from Dev.to)
DEVTO_API_KEY=your_devto_api_key_here
