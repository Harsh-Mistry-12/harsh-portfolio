# Environment Variables Template
# Copy this file to .env.local for local development

# -----------------------------------------------------------------------------
# Site Configuration
# -----------------------------------------------------------------------------
# Base URL for the website (used for SEO canonical tags, OpenGraph images, sitemap, and robots.txt)
NEXT_PUBLIC_SITE_URL=https://mistry-harsh.vercel.app

# -----------------------------------------------------------------------------
# Contact Form SMTP Configuration (Gmail / Nodemailer)
# -----------------------------------------------------------------------------
# Recipient Email Address where contact form submissions will be sent
CONTACT_RECEIVER_EMAIL=hmistry864@gmail.com

# SMTP Server details
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Your Gmail address used to send the emails
SMTP_USER=hmistry864@gmail.com

# Gmail App Password (16-character code generated from your Google Account > Security > 2-Step Verification > App Passwords)
# Note: Do NOT use your standard Gmail password here!
SMTP_PASS=your_gmail_app_password_here

# -----------------------------------------------------------------------------
# Search Engine Verification
# -----------------------------------------------------------------------------
# Google Search Console Verification Code
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_site_verification_code_here

# -----------------------------------------------------------------------------
# Blog API Integrations (Optional)
# -----------------------------------------------------------------------------
# Dev.to API Key (Optional: for fetching draft/private posts from Dev.to)
DEVTO_API_KEY=your_devto_api_key_here
